# =============================================================
# SIH Health Memory — Environment Variables Template
# Copy to .env.local and fill in your values.
# =============================================================

# ── Supabase (required) ──────────────────────────────────────
# Get from: https://app.supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI / Translation Proxy (recommended) ─────────────────────
# Deploy `supabase/functions/groq-proxy/index.ts` so your GROQ_API_KEY
# lives as a server-side secret, NOT in the client bundle:
#
#   supabase functions deploy groq-proxy
#   supabase secrets set GROQ_API_KEY=sk-...your-groq-key...
#
# If VITE_GROQ_PROXY_URL is set, the app calls the Edge Function
# instead of hitting Groq directly. If unset, the app falls back to
# the browser-based path (VITE_GROQ_API_KEY) — NOT recommended
# for production due to key exposure.
VITE_GROQ_PROXY_URL=https://your-project.supabase.co/functions/v1/groq-proxy

# ── Optional: direct Groq key (browser path, NOT recommended) ─
# Only needed if VITE_GROQ_PROXY_URL is NOT set.
VITE_GROQ_API_KEY=your-groq-api-key-here

# ── ABHA (Ayushman Bharat Health Account) login ───────────────
# With "true" (default), ABHA login is fully mocked in the browser —
# enter any <name>@abdm address, the OTP is generated deterministically
# and displayed on screen so judges can enter it without a real
# ABDM account or SIM-bound number. To use the live ABDM gateway
# you must register with NHA and implement your own proxy.
VITE_ABHA_MOCK=true

# ── App environment ──────────────────────────────────────────
VITE_APP_ENV=development
