# =============================================================
# SIH Health Memory — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# Supabase (free tier) — get these from your Supabase project dashboard:
# https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Groq AI (free tier) — get your key from:
# https://console.groq.com
VITE_GROQ_API_KEY=your-groq-api-key-here

# ABHA (Ayushman Bharat Health Account) login — client-side mock
# No real ABDM sandbox account required. The ABHA login flow is
# mocked in src/services/abhaService.js using deterministic OTPs
# and profiles derived from the ABHA address.
# To use real ABDM instead, set to false and configure the real
# sandbox + edge function.
VITE_ABHA_MOCK=true

# App environment
VITE_APP_ENV=development

